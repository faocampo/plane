{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/schemas/prd-review-context-input-v1.schema.json",
  "title": "PRD review context trusted metadata input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "initiative_id",
    "snapshot_revision",
    "initiative_version",
    "state",
    "risk_tier",
    "current_checkpoint_id",
    "controlling_decision_id",
    "current_readiness_report_id",
    "binding",
    "checkpoint",
    "decision",
    "readiness",
    "current_readiness_subject",
    "current_profile_digest",
    "assignments",
    "decision_assignment",
    "schema_version"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "snapshot_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "DRAFT",
        "ALIGNING",
        "PRD_REVIEW",
        "PLANNING",
        "PLAN_REVIEW",
        "EXECUTING",
        "CODE_READINESS_REVIEW",
        "READY_FOR_REPOSITORY_REVIEW",
        "PAUSED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "risk_tier": {
      "enum": [
        "LOW",
        "STANDARD",
        "HIGH"
      ]
    },
    "current_checkpoint_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "controlling_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_readiness_report_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "$ref": "#/$defs/binding_envelope"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint_envelope"
    },
    "decision": {
      "$ref": "#/$defs/decision_envelope"
    },
    "readiness": {
      "$ref": "#/$defs/report_envelope"
    },
    "current_readiness_subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_profile_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      },
      "maxItems": 20
    },
    "decision_assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/assignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "curve.prd-review-context-input/v1-candidate"
    }
