{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/manual-gate2-v3/preparation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "curve.manual-plan.preparation/v3-candidate"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "product_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "payload": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://curve.example.invalid/candidates/manual-planning-v3/manual-plan-draft-save-v3.schema.json",
            "title": "Closed manual draft save metadata",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "policy_edition",
              "expected_draft_revision",
              "approved_subject_ref",
              "definition_ref",
              "manual_profile_ref"
            ],
            "properties": {
              "schema_version": {
                "const": "curve.manual-plan-draft.save/v3-candidate"
              },
              "policy_edition": {
                "const": "LOCAL_MANUAL_PLAN_DRAFT_RECONSTRUCTION_V3"
              },
              "expected_draft_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "approved_subject_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity_id",
                  "digest"
                ],
                "properties": {
                  "entity_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "definition_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "object_id",
                  "digest",
                  "size_bytes",
                  "media_type"
                ],
                "properties": {
                  "object_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5242880
                  },
                  "media_type": {
                    "const": "application/json"
                  }
                }
              },
              "manual_profile_ref": {
                "allOf": [
                  {
                    "allOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "entity_id",
                          "digest"
                        ],
                        "properties": {
                          "entity_id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          }
                        }
                      }
                    ],
                    "const": {
                      "entity_id": "20000000-0000-4000-8000-000000000301",
                      "digest": "sha256:fbfaf1ae8608aa580c5d76514a948ef515f8e0795248d180840fb89779f5a1e8"
                    }
                  }
                ],
                "const": {
                  "entity_id": "20000000-0000-4000-8000-000000000301",
                  "digest": "sha256:fbfaf1ae8608aa580c5d76514a948ef515f8e0795248d180840fb89779f5a1e8"
                }
              }
            }
          }
        },
        "required": [
          "payload"
        ]
      },
      "maxItems": 25,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "product_id",
    "initiative_id",
    "initiative_version",
    "plans"
  ]
}
