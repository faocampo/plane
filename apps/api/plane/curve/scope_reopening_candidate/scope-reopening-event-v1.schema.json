{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/scope-reopening-v1/scope-reopening-event-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_edition",
    "event_type",
    "reopening_id",
    "reopening_digest",
    "initiative_id",
    "scope_revision_id",
    "policy_decision_id"
  ],
  "properties": {
    "schema_version": {
      "const": "curve.scope-reopening/v1-candidate"
    },
    "policy_edition": {
      "const": "EXPLICIT_EXISTING_WORK_SCOPE_REOPENING_V1"
    },
    "event_type": {
      "const": "CURVE.SCOPE.REOPENED_AND_REPLACED"
    },
    "reopening_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "reopening_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "initiative_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scope_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_decision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
