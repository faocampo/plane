{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/scope-reopening-v1/scope-reopening-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_edition",
    "id",
    "workspace_id",
    "product_id",
    "initiative_id",
    "previous_initiative_version",
    "initiative_version",
    "previous_state",
    "state",
    "revision",
    "reason_digest",
    "historical_checkpoint_status",
    "approval_invalidated",
    "prd_authority",
    "created_by",
    "recorded_at",
    "policy_decision_id",
    "command_receipt_id",
    "digest",
    "controlling"
  ],
  "properties": {
    "schema_version": {
      "const": "curve.scope-reopening/v1-candidate"
    },
    "policy_edition": {
      "const": "EXPLICIT_EXISTING_WORK_SCOPE_REOPENING_V1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "product_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "previous_initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_state": {
      "enum": [
        "ALIGNING",
        "PRD_REVIEW",
        "PLANNING"
      ]
    },
    "state": {
      "const": "ALIGNING"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "workspace_id",
        "proposal_id",
        "initiative_id",
        "product_id",
        "version",
        "initiative_version",
        "predecessor_id",
        "item_count",
        "delivery_count",
        "membership_digest",
        "created_by",
        "recorded_at",
        "policy_edition",
        "command_receipt_id",
        "controlling",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "initiative_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "product_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "initiative_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "predecessor_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "item_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "delivery_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "membership_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_edition": {
          "const": "REOPENED_EXISTING_WORK_SCOPE_PROPOSAL_V1"
        },
        "command_receipt_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "controlling": {
          "const": false
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "association_id",
              "association_version",
              "source_issue_id",
              "purpose",
              "provider_installation_id",
              "source_project_id",
              "source_observed_at",
              "source_version",
              "source_fingerprint"
            ],
            "properties": {
              "association_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "association_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "source_issue_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "purpose": {
                "enum": [
                  "CONTEXT_EVIDENCE",
                  "PROPOSED_DELIVERY"
                ]
              },
              "provider_installation_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "source_project_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "source_observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "source_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "reason_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "historical_checkpoint_status": {
      "enum": [
        "NONE",
        "RETAINED_STALE"
      ]
    },
    "approval_invalidated": {
      "type": "boolean"
    },
    "prd_authority": {
      "const": "REQUIRES_FRESH_SCOPED_SUBMISSION"
    },
    "created_by": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_decision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "command_receipt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controlling": {
      "const": false
    }
  }
}
