{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/candidates/item-scope-prepared-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "product_id",
    "roadmap_id",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "product_id": {
      "type": "string",
      "format": "uuid"
    },
    "roadmap_id": {
      "type": "string",
      "format": "uuid"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id",
        "resource_version",
        "scope_body"
      ],
      "properties": {
        "resource_type": {
          "const": "PREPARED_ITEM_SCOPE"
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "resource_version": {
          "const": 1
        },
        "scope_body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_id",
            "digest",
            "size_bytes",
            "media_type",
            "editor_schema_version"
          ],
          "properties": {
            "object_id": {
              "type": "string",
              "format": "uuid"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "media_type": {
              "const": "application/json"
            },
            "editor_schema_version": {
              "const": "curve.item-scope-markdown/v1-candidate"
            }
          }
        }
      }
    }
  }
}
