{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/manual-gate2-v2/material.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "product_id",
    "initiative_id",
    "initiative_version",
    "schema_version",
    "kind",
    "reference",
    "content"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "product_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "schema_version": {
      "const": "curve.manual-gate2.material/v2-candidate"
    },
    "kind": {
      "enum": [
        "DEFINITION",
        "RATIONALE"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "digest",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "media_type": {
          "const": "application/json"
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5242880
    }
  }
}
