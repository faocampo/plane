  "required": [
    "schema_version",
    "workspace_id",
    "product_id",
    "initiative_id",
    "initiative_version",
    "state",
    "effective_hold",
    "current_record",
    "subject_ref",
    "draft_revision_id",
    "claims",
    "allowed_actions",
    "rationales",
    "execution_authorized",
    "completion_credit",
    "definition_ref"
  ]
