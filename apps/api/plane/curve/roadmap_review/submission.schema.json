{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "initiative_id",
    "source_id",
    "submitted_by",
    "initiative_version",
    "source_version",
    "source_digest",
    "content_digest",
    "digest",
    "schema_version",
    "reviewers",
    "risk_tier",
    "submitted_at",
    "product_id",
    "product_version",
    "business_intent",
    "roadmap_item_id",
    "roadmap_item_scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "submitted_by": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "initiative_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "curve.local-prd-submission/v3-roadmap-candidate"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_type",
          "gate_assignment_id",
          "approver_user_id"
        ],
        "properties": {
          "gate_type": {
            "enum": [
              "PLAN_APPROVAL",
              "PRD_APPROVAL"
            ]
          },
          "gate_assignment_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "approver_user_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    "risk_tier": {
      "enum": [
        "LOW",
        "STANDARD",
        "HIGH"
      ]
    },
    "submitted_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d{1,6})?Z$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "product_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "business_intent": {
      "enum": [
        "STRATEGIC",
        "CUSTOMER_COMMITMENT",
        "BUSINESS_IMPROVEMENT",
        "MANDATORY"
      ]
    },
    "roadmap_item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "roadmap_item_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "digest",
        "size_bytes",
        "media_type",
        "editor_schema_version"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "editor_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
