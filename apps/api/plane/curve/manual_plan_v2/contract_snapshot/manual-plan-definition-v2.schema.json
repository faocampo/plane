{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/manual-planning-v2/manual-plan-definition-v2.schema.json",
  "title": "Protected inert manual plan definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "initiative_id",
    "plan_kind",
    "initiative_mode",
    "approved_subject_ref",
    "manual_profile_ref",
    "workflow_ref",
    "quality_policy_ref",
    "scope_revision_ref",
    "repositories",
    "slices",
    "dependencies",
    "standalone_applicability",
    "automatic_execution"
  ],
  "properties": {
    "schema_version": {
      "const": "curve.manual-plan-definition/v2-candidate"
    },
    "workspace_id": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/OpaqueId"
    },
    "initiative_id": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/OpaqueId"
    },
    "plan_kind": {
      "const": "SDLC_MANUAL"
    },
    "initiative_mode": {
      "const": "STANDALONE"
    },
    "approved_subject_ref": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
    },
    "manual_profile_ref": {
      "allOf": [
        {
          "allOf": [
            {
              "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
            }
          ],
          "const": {
            "entity_id": "20000000-0000-4000-8000-000000000201",
            "digest": "sha256:16ddfbb742fb06e370e1c2db3723eb98c826e1454bf237d97f678656649314a4"
          }
        }
      ],
      "const": {
        "entity_id": "20000000-0000-4000-8000-000000000201",
        "digest": "sha256:16ddfbb742fb06e370e1c2db3723eb98c826e1454bf237d97f678656649314a4"
      }
    },
    "workflow_ref": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
    },
    "quality_policy_ref": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
    },
    "scope_revision_ref": {
      "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_ref",
          "base_branch",
          "base_commit",
          "repository_policy_ref",
          "context_input_ref"
        ],
        "properties": {
          "repository_ref": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
          },
          "base_branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          },
          "base_commit": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/CommitRef"
          },
          "repository_policy_ref": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
          },
          "context_input_ref": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/ObjectRef"
          }
        }
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slice_key",
          "repository_binding_id",
          "user_outcome",
          "in_scope",
          "out_of_scope",
          "requirement_ids",
          "acceptance_ids",
          "proposed_delivery_refs",
          "expected_components",
          "interfaces",
          "migration_impact",
          "compatibility_impact",
          "verification_steps",
          "branch_name",
          "owner",
          "code_approver",
          "risk_tier",
          "budget_policy_ref",
          "rollback_plan"
        ],
        "properties": {
          "slice_key": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/SliceKey"
          },
          "repository_binding_id": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/OpaqueId"
          },
          "user_outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "\\S"
          },
          "in_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "out_of_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/RequirementId"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/AcceptanceId"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "proposed_delivery_refs": {
            "type": "array",
            "items": {
              "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/StableIssueRef"
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "expected_components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "change"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "CREATE",
                    "MODIFY",
                    "DELETE",
                    "READ_ONLY"
                  ]
                }
              }
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "change",
                "rationale"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "\\S"
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "NONE",
                    "ADD",
                    "CHANGE",
                    "REMOVE"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                }
              }
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          },
          "migration_impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rationale"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "NONE",
                  "ADDITIVE",
                  "BREAKING"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          },
          "compatibility_impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "rationale"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "NONE",
                  "ADDITIVE",
                  "BREAKING"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          },
          "verification_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check_id",
                "command_text",
                "expected_result",
                "timeout_seconds",
                "execution_mode"
              ],
              "properties": {
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                },
                "command_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "expected_result": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "\\S"
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "execution_mode": {
                  "const": "INERT_HUMAN_INSTRUCTION"
                }
              }
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "branch_name": {
            "type": "string",
            "pattern": "^curve/[a-z][a-z0-9-]{0,79}/[a-z][a-z0-9-]{0,79}$"
          },
          "owner": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/HumanRef"
          },
          "code_approver": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/HumanRef"
          },
          "risk_tier": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/RiskTier"
          },
          "budget_policy_ref": {
            "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
          },
          "rollback_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "instructions",
              "verification"
            ],
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "REVERT_COMMIT",
                  "FORWARD_FIX",
                  "NO_EXTERNAL_EFFECTS"
                ]
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "pattern": "\\S"
              },
              "verification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predecessor_slice_key",
              "successor_slice_key",
              "dependency_type",
              "required_state",
              "artifact_ref",
              "condition_status",
              "condition_subject",
              "condition_source",
              "workflow_ref"
            ],
            "properties": {
              "predecessor_slice_key": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/SliceKey"
              },
              "successor_slice_key": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/SliceKey"
              },
              "dependency_type": {
                "const": "EXECUTION_ORDER"
              },
              "required_state": {
                "const": "DRAFT_ELIGIBLE"
              },
              "artifact_ref": {
                "anyOf": [
                  {
                    "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/ObjectRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition_status": {
                "const": "FUTURE_NOT_ASSERTED"
              },
              "condition_subject": {
                "const": "VERTICAL_SLICE"
              },
              "condition_source": {
                "const": "PINNED_WORKFLOW_STATE"
              },
              "workflow_ref": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predecessor_slice_key",
              "successor_slice_key",
              "dependency_type",
              "required_state",
              "artifact_ref",
              "condition_status",
              "condition_subject",
              "condition_source",
              "workflow_ref"
            ],
            "properties": {
              "predecessor_slice_key": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/SliceKey"
              },
              "successor_slice_key": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/SliceKey"
              },
              "dependency_type": {
                "const": "MERGE_ORDER"
              },
              "required_state": {
                "const": "MERGED"
              },
              "artifact_ref": {
                "anyOf": [
                  {
                    "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/ObjectRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition_status": {
                "const": "FUTURE_NOT_ASSERTED"
              },
              "condition_subject": {
                "const": "PR_MR_BINDING"
              },
              "condition_source": {
                "const": "VCS_OBSERVATION_ONLY"
              },
              "workflow_ref": {
                "$ref": "https://curve.example.invalid/candidates/manual-planning-v2/common-v2.schema.json#/$defs/DigestVersionRef"
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "standalone_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rationale",
        "contract_obligation_ids"
      ],
      "properties": {
        "decision": {
          "const": "NO_FEATURE_DELIVERY_CONTRACT"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "contract_obligation_ids": {
          "const": []
        }
      }
    },
    "automatic_execution": {
      "const": "DENIED"
    }
  }
}
