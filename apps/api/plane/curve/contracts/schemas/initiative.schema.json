{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/initiative.schema.json",
  "title": "Curve Initiative",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "product_id",
    "mode",
    "roadmap_item_id",
    "keyword",
    "title",
    "description",
    "risk_tier",
    "state",
    "paused_from_state",
    "workflow_version_id",
    "creator",
    "gate_assignments",
    "first_external_resource_at",
    "version",
    "created_at",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "product_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
    "mode": { "type": "string", "enum": ["ROADMAP", "STANDALONE"] },
    "roadmap_item_id": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/OpaqueId" }, { "type": "null" }]
    },
    "keyword": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,49}$",
      "maxLength": 50
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "$ref": "#/$defs/richTextDocument" },
    "risk_tier": { "type": "string", "enum": ["LOW", "STANDARD", "HIGH"] },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ALIGNING",
        "PRD_REVIEW",
        "PLANNING",
        "PLAN_REVIEW",
        "EXECUTING",
        "CODE_READINESS_REVIEW",
        "READY_FOR_REPOSITORY_REVIEW",
        "PAUSED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "paused_from_state": {
      "type": ["string", "null"],
      "enum": ["DRAFT", "ALIGNING", null]
    },
    "workflow_version_id": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/OpaqueId" }, { "type": "null" }]
    },
    "creator": { "$ref": "product.schema.json#/$defs/humanActor" },
    "gate_assignments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "gate-assignment.schema.json" }
    },
    "first_external_resource_at": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Instant" }, { "type": "null" }]
    },
    "version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
    "created_at": { "$ref": "common.schema.json#/$defs/Instant" },
    "updated_at": { "$ref": "common.schema.json#/$defs/Instant" },
    "updated_by": { "$ref": "product.schema.json#/$defs/humanActor" }
  },
  "$defs": {
    "richTextDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "format", "body"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "format": { "const": "MARKDOWN" },
        "body": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "STANDALONE" } }, "required": ["mode"] },
      "then": { "properties": { "roadmap_item_id": { "type": "null" } } }
    },
    {
      "if": { "properties": { "mode": { "const": "ROADMAP" } }, "required": ["mode"] },
      "then": { "properties": { "roadmap_item_id": { "$ref": "common.schema.json#/$defs/OpaqueId" } } }
    },
    {
      "if": { "properties": { "state": { "const": "DRAFT" } }, "required": ["state"] },
      "then": { "properties": { "workflow_version_id": { "type": "null" } } }
    },
    {
      "if": { "properties": { "state": { "const": "ALIGNING" } }, "required": ["state"] },
      "then": { "properties": { "workflow_version_id": { "$ref": "common.schema.json#/$defs/OpaqueId" } } }
    },
    {
      "if": { "properties": { "state": { "const": "PAUSED" } }, "required": ["state"] },
      "then": { "properties": { "paused_from_state": { "type": "string", "enum": ["DRAFT", "ALIGNING"] } } },
      "else": { "properties": { "paused_from_state": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "PAUSED" },
          "paused_from_state": { "const": "DRAFT" }
        },
        "required": ["state", "paused_from_state"]
      },
      "then": { "properties": { "workflow_version_id": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "PAUSED" },
          "paused_from_state": { "const": "ALIGNING" }
        },
        "required": ["state", "paused_from_state"]
      },
      "then": { "properties": { "workflow_version_id": { "$ref": "common.schema.json#/$defs/OpaqueId" } } }
    }
  ]
}
