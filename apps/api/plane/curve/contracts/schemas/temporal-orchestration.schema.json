{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/schemas/temporal-orchestration.schema.json",
  "title": "Curve M0-S6A durable orchestration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_key",
    "contract_version",
    "authority",
    "payload_policy",
    "primitive_contracts",
    "initialization",
    "workflow_types",
    "signals",
    "queries",
    "command_codes",
    "scheduling",
    "timeouts",
    "cancellation",
    "continue_as_new",
    "versioning",
    "acceptance_tests"
  ],
  "properties": {
    "schema_version": { "const": "curve.temporal-orchestration/v1" },
    "contract_key": { "const": "CURVE_M0_S6A_DURABLE_ORCHESTRATION" },
    "contract_version": { "const": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "temporal_python_sdk",
        "namespace",
        "task_queue",
        "domain_truth",
        "orchestration_truth",
        "execution_mode",
        "external_side_effects_allowed"
      ],
      "properties": {
        "environment": { "const": "LOCAL_ONLY" },
        "temporal_python_sdk": { "const": "1.31.0" },
        "namespace": { "const": "curve-local" },
        "task_queue": { "const": "curve-control-plane-v1" },
        "domain_truth": { "const": "POSTGRESQL_APPLICATION_SERVICES" },
        "orchestration_truth": { "const": "TEMPORAL_HISTORY_CONTROL_STATE_ONLY" },
        "execution_mode": { "const": "SYNTHETIC_CONTROL_ONLY" },
        "external_side_effects_allowed": { "const": false }
      }
    },
    "payload_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_value_types",
        "maximum_slices",
        "maximum_dependencies_per_slice",
        "maximum_processed_commands",
        "maximum_questions_per_attempt",
        "forbidden_field_fragments",
        "protected_payloads_allowed",
        "free_text_allowed",
        "credentials_allowed"
      ],
      "properties": {
        "allowed_value_types": {
          "const": ["UUID", "POSITIVE_INTEGER", "NON_NEGATIVE_INTEGER", "SHA256_DIGEST", "BOUNDED_ENUM", "OPAQUE_REFERENCE"]
        },
        "maximum_slices": { "const": 64 },
        "maximum_dependencies_per_slice": { "const": 16 },
        "maximum_processed_commands": { "const": 256 },
        "maximum_questions_per_attempt": { "const": 32 },
        "forbidden_field_fragments": {
          "const": [
            "body",
            "content",
            "credential",
            "evidence_body",
            "patch",
            "prompt",
            "response",
            "secret",
            "source_code",
            "token",
            "tool_output"
          ]
        },
        "protected_payloads_allowed": { "const": false },
        "free_text_allowed": { "const": false },
        "credentials_allowed": { "const": false }
      }
    },
    "primitive_contracts": {
      "const": {
        "message_schema_version": "1.0",
        "uuid_pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "positive_integer_minimum": 1,
        "positive_integer_maximum": 2147483647,
        "non_negative_integer_minimum": 0,
        "non_negative_integer_maximum": 2147483647,
        "sha256_digest_pattern": "^sha256:[0-9a-f]{64}$",
        "opaque_reference_pattern": "^[a-z][a-z0-9._:/-]{0,127}$",
        "command_record_fields": ["command_id", "payload_digest", "disposition", "rejection_code"],
        "state_dependent_null_fields": [
          "active_question_ref",
          "active_question_digest",
          "answer_ref",
          "answer_digest",
          "failure_code",
          "last_rejected_command_id",
          "last_command_rejection_code"
        ],
        "unknown_fields_allowed": false
      }
    },
    "initialization": {
      "const": {
        "workflow_kind": "PARENT",
        "continued_run_detection_api": "workflow.info().continued_run_id",
        "external_preloaded_state_allowed": false,
        "initial_defaults": {
          "phase": "RUNNING",
          "state_version": 1,
          "completed_slice_ids": [],
          "failed_slice_ids": [],
          "cancelled_slice_ids": [],
          "next_wave_index": 0,
          "processed_commands": [],
          "continue_as_new_count": 0,
          "last_rejected_command_id": null,
          "last_command_rejection_code": null
        },
        "continued_run_requirements": [
          "CONTINUED_RUN_ID_PRESENT",
          "EXACT_CARRY_FORWARD_FIELDS",
          "PLAN_IDENTITY_UNCHANGED",
          "STATE_VERSION_MONOTONIC",
          "CONTINUE_AS_NEW_COUNT_INCREMENTED_ONCE"
        ]
      }
    },
    "workflow_types": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workflowType" }
    },
    "signals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/handler" }
    },
    "queries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/handler" }
    },
    "command_codes": {
      "const": {
        "command_dispositions": ["ACCEPTED", "REJECTED"],
        "cancel_reason_codes": ["USER_REQUESTED", "POLICY_REQUESTED", "SUPERSEDED"],
        "completion_outcomes": ["SUCCEEDED", "FAILED_RETRYABLE", "FAILED_TERMINAL"],
        "failure_codes": [
          "START_TIMEOUT",
          "ATTEMPT_TIMEOUT",
          "QUESTION_TIMEOUT",
          "SYNTHETIC_FAILURE",
          "CANCEL_TIMEOUT"
        ],
        "validation_error_codes": [
          "INVALID_IDENTIFIER",
          "INVALID_VERSION",
          "INVALID_DIGEST",
          "UNKNOWN_DEPENDENCY",
          "DUPLICATE_SLICE",
          "SELF_DEPENDENCY",
          "CYCLIC_DEPENDENCY",
          "COLLECTION_LIMIT_EXCEEDED"
        ],
        "signal_error_codes": [
          "COMMAND_CONFLICT",
          "STALE_STATE_VERSION",
          "INVALID_TRANSITION",
          "TARGET_MISMATCH",
          "COMMAND_LIMIT_EXCEEDED"
        ]
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "tie_breaker",
        "dependency_success_state",
        "cycle_behavior",
        "duplicate_slice_behavior",
        "child_start_api",
        "workflow_id_reuse_policy",
        "duplicate_start_behavior",
        "parent_close_policy",
        "child_cancellation_type",
        "provider_dispatch_allowed"
      ],
      "properties": {
        "algorithm": { "const": "TOPOLOGICAL_WAVES" },
        "tie_breaker": { "const": "SLICE_ID_ASCENDING" },
        "dependency_success_state": { "const": "SUCCEEDED" },
        "cycle_behavior": { "const": "REJECT_BEFORE_CHILD_START" },
        "duplicate_slice_behavior": { "const": "REJECT_BEFORE_CHILD_START" },
        "child_start_api": { "const": "workflow.start_child_workflow" },
        "workflow_id_reuse_policy": { "const": "WorkflowIDReusePolicy.REJECT_DUPLICATE" },
        "duplicate_start_behavior": { "const": "WORKFLOW_ALREADY_STARTED_NO_SECOND_EXECUTION" },
        "parent_close_policy": { "const": "REQUEST_CANCEL" },
        "child_cancellation_type": { "const": "WAIT_CANCELLATION_COMPLETED" },
        "provider_dispatch_allowed": { "const": false }
      }
    },
    "timeouts": {
      "const": {
        "child_start_signal_seconds": 30,
        "attempt_terminal_seconds": 7200,
        "question_answer_seconds": 86400,
        "parent_cancel_completion_seconds": 120
      }
    },
    "cancellation": {
      "const": {
        "stop_new_child_starts_first": true,
        "cancel_active_children": true,
        "wait_for_child_terminal_state": true,
        "synthetic_cleanup_only": true,
        "terminal_parent_state": "CANCELLED",
        "timeout_behavior": "FAIL_PARENT_WITH_CANCEL_TIMEOUT"
      }
    },
    "continue_as_new": {
      "const": {
        "workflow_kind": "PARENT",
        "sdk_suggestion_api": "workflow.info().is_continue_as_new_suggested()",
        "completed_wave_threshold": 10,
        "required_barrier": "BETWEEN_WAVES_WITH_ZERO_ACTIVE_CHILDREN",
        "wait_for_handlers_api": "workflow.all_handlers_finished()",
        "carry_forward": [
          "workspace_id",
          "initiative_id",
          "plan_generation",
          "plan_digest",
          "slices",
          "phase",
          "state_version",
          "completed_slice_ids",
          "failed_slice_ids",
          "cancelled_slice_ids",
          "next_wave_index",
          "processed_commands",
          "continue_as_new_count",
          "last_rejected_command_id",
          "last_command_rejection_code"
        ]
      }
    },
    "versioning": {
      "const": {
        "existing_workflow_unchanged": "CurveOperationWorkflowV1",
        "required_patch_markers": [
          "curve-m0-s6a-parent-v1",
          "curve-m0-s6a-child-v1"
        ],
        "worker_registration": "ADDITIVE",
        "replay_corpus": [
          "curve-operation-v1.json",
          "curve-initiative-orchestration-v1.json",
          "curve-slice-attempt-v1.json",
          "curve-initiative-orchestration-continued-v1.json"
        ],
        "incompatible_change_policy": "NEW_WORKFLOW_TYPE_OR_PATCHED_COMPATIBLE_BRANCH"
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M0-S6A-AT-(0[1-9]|1[0-2])$"
      }
    }
  },
  "$defs": {
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_kind", "name", "fields"],
      "properties": {
        "workflow_kind": { "enum": ["PARENT", "CHILD"] },
        "name": { "$ref": "#/$defs/fieldName" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldName" }
        }
      }
    },
    "workflowType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "workflow_id_template",
        "input_fields",
        "state_fields",
        "output_fields",
        "phase_values"
      ],
      "properties": {
        "kind": { "enum": ["PARENT", "CHILD"] },
        "name": { "type": "string", "pattern": "^Curve[A-Za-z0-9]+WorkflowV1$" },
        "workflow_id_template": { "type": "string", "minLength": 20, "maxLength": 255 },
        "input_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldName" }
        },
        "state_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldName" }
        },
        "output_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldName" }
        },
        "phase_values": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }
        }
      }
    }
  }
}
