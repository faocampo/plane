{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.x3m.internal/contracts/schemas/policy-evaluation.schema.json",
  "title": "Curve policy evaluation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "subject",
    "effective_principal",
    "membership",
    "roles",
    "action",
    "resource",
    "classification",
    "environment",
    "feature_enabled",
    "object_acl",
    "assignment_context",
    "target_context",
    "service_authorization",
    "evaluated_at",
    "policy_manifest_digest",
    "correlation_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "subject": { "$ref": "common.schema.json#/$defs/ActorRef" },
    "effective_principal": { "$ref": "common.schema.json#/$defs/ActorRef" },
    "membership": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/membership" }]
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
    },
    "resource": { "$ref": "#/$defs/resourceContext" },
    "classification": {
      "type": "string",
      "enum": ["INTERNAL", "CONFIDENTIAL", "RESTRICTED", "UNKNOWN"]
    },
    "environment": {
      "type": "string",
      "enum": ["LOCAL", "STAGING", "PRODUCTION"]
    },
    "feature_enabled": { "type": "boolean" },
    "object_acl": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/objectAcl" }]
    },
    "assignment_context": { "$ref": "#/$defs/assignmentContext" },
    "target_context": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/targetContext" }]
    },
    "service_authorization": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/serviceAuthorization" }]
    },
    "evaluated_at": { "$ref": "common.schema.json#/$defs/Instant" },
    "policy_manifest_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 255 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": { "actor_type": { "const": "HUMAN" } },
            "required": ["actor_type"]
          }
        }
      },
      "then": {
        "properties": {
          "membership": { "$ref": "#/$defs/membership" },
          "roles": {
            "not": { "contains": { "const": "TRUSTED_SERVICE" } }
          },
          "service_authorization": { "type": "null" }
        }
      },
      "else": {
        "properties": { "membership": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": { "actor_type": { "const": "SERVICE" } },
            "required": ["actor_type"]
          }
        }
      },
      "then": {
        "properties": {
          "roles": { "const": ["TRUSTED_SERVICE"] },
          "service_authorization": {
            "$ref": "#/$defs/serviceAuthorization"
          }
        }
      },
      "else": {
        "properties": { "service_authorization": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "actor_type": { "enum": ["AGENT", "SYSTEM"] }
            },
            "required": ["actor_type"]
          }
        }
      },
      "then": {
        "properties": { "roles": { "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "WORKSPACE_MEMBER",
        "PRODUCT_APPROVER",
        "TECHNICAL_APPROVER",
        "CODE_APPROVER",
        "PLATFORM_ADMINISTRATOR",
        "TRUSTED_SERVICE"
      ]
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "active", "plane_role"],
      "properties": {
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "active": { "type": "boolean" },
        "plane_role": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "enum": ["ADMIN", "MEMBER", "GUEST"] }
          ]
        }
      }
    },
    "resourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "ref", "exists", "owner"],
      "properties": {
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "ref": { "$ref": "common.schema.json#/$defs/ResourceRef" },
        "exists": { "type": "boolean" },
        "owner": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.schema.json#/$defs/ActorRef" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "exists": { "const": false } } },
          "then": { "properties": { "owner": { "type": "null" } } }
        }
      ]
    },
    "objectAcl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "resource_ref",
        "acl_version",
        "allow_principals",
        "deny_principals",
        "allow_roles",
        "deny_roles"
      ],
      "properties": {
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "resource_ref": { "$ref": "common.schema.json#/$defs/ResourceRef" },
        "acl_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
        "allow_principals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ActorRef" }
        },
        "deny_principals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ActorRef" }
        },
        "allow_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "deny_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "gateAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "principal", "active"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["PRODUCT_APPROVER", "TECHNICAL_APPROVER", "CODE_APPROVER"]
        },
        "principal": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/ActorRef" },
            {
              "properties": {
                "actor_type": { "const": "HUMAN" }
              }
            }
          ]
        },
        "active": { "const": true }
      }
    },
    "assignmentContext": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assignmentContextValue" }]
    },
    "assignmentContextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "subject_ref",
        "assignment_version",
        "risk_tier",
        "gate_assignments",
        "material_contributors",
        "low_risk_overlap_allowed",
        "overlap_exception_ref"
      ],
      "properties": {
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "subject_ref": { "$ref": "common.schema.json#/$defs/ResourceRef" },
        "assignment_version": { "$ref": "common.schema.json#/$defs/AggregateVersion" },
        "risk_tier": {
          "type": "string",
          "enum": ["LOW", "STANDARD", "HIGH"]
        },
        "gate_assignments": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/gateAssignment" }
        },
        "material_contributors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ActorRef" }
        },
        "low_risk_overlap_allowed": { "type": "boolean" },
        "overlap_exception_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/versionedResourceRef" }
          ]
        }
      }
    },
    "targetContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "configuration_ref",
        "target_type",
        "target_id",
        "allowed_targets"
      ],
      "properties": {
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "configuration_ref": { "$ref": "#/$defs/versionedResourceRef" },
        "target_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
        },
        "target_id": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "allowed_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "serviceAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authorization_version",
        "workspace_id",
        "service",
        "active",
        "allowed_actions",
        "issued_at",
        "expires_at"
      ],
      "properties": {
        "authorization_id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "authorization_version": {
          "$ref": "common.schema.json#/$defs/AggregateVersion"
        },
        "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
        "service": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/ActorRef" },
            {
              "properties": {
                "actor_type": { "const": "SERVICE" }
              }
            }
          ]
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$"
          }
        },
        "active": { "type": "boolean" },
        "issued_at": { "$ref": "common.schema.json#/$defs/Instant" },
        "expires_at": { "$ref": "common.schema.json#/$defs/Instant" }
      }
    },
    "versionedResourceRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/ResourceRef" },
        { "required": ["resource_version"] }
      ]
    }
  }
}
