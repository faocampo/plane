{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/contracts/schemas/sse-event.schema.json",
  "title": "Curve resumable SSE event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "workspace_id", "event_type", "occurred_at", "resource", "data"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "$ref": "common.schema.json#/$defs/WorkspaceId" },
    "event_type": { "type": "string" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/Instant" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": { "type": "string" },
        "id": { "$ref": "common.schema.json#/$defs/OpaqueId" },
        "version": { "$ref": "common.schema.json#/$defs/AggregateVersion" }
      }
    },
    "data": { "type": "object", "additionalProperties": true }
  }
}
