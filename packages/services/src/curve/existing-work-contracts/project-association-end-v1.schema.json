{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curve.example.invalid/candidates/project-association-end-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_product_version",
    "reason"
  ],
  "properties": {
    "expected_product_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  }
}
