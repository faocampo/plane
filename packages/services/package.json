{
  "name": "@plane/services",
  "version": "1.4.2",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node generate-prd-read-validator.mjs && tsdown",
    "dev": "node generate-prd-read-validator.mjs && tsdown --watch --no-clean",
    "check:lint": "oxlint --max-warnings=6 .",
    "check:types": "node generate-prd-read-validator.mjs && tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist",
    "generate:prd-validator": "node generate-prd-read-validator.mjs"
  },
  "dependencies": {
    "@plane/constants": "workspace:*",
    "@plane/types": "workspace:*",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "axios": "catalog:",
    "file-type": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
